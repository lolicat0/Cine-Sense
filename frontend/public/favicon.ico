<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8b45c1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#d946ef;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- Background circle -->
  <circle cx="16" cy="16" r="16" fill="url(#grad)"/>
  <!-- Film reel design -->
  <circle cx="16" cy="16" r="12" fill="none" stroke="white" stroke-width="2"/>
  <circle cx="16" cy="16" r="6" fill="none" stroke="white" stroke-width="1"/>
  <!-- Film holes -->
  <circle cx="10" cy="8" r="1.5" fill="white"/>
  <circle cx="22" cy="8" r="1.5" fill="white"/>
  <circle cx="10" cy="24" r="1.5" fill="white"/>
  <circle cx="22" cy="24" r="1.5" fill="white"/>
  <!-- Center -->
  <circle cx="16" cy="16" r="2" fill="white"/>
</svg>